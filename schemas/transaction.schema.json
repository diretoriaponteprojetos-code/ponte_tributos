{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ponte-projetos.dev/schemas/transaction.schema.json",
  "title": "Transaction (L3)",
  "description": "Operação econômica documentada (venda, compra, serviço).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "transaction_id": { "$ref": "common.schema.json#/$defs/transaction_id" },
    "taxpayer": { "$ref": "common.schema.json#/$defs/taxpayer_id" },
    "kind": { "type": "string", "enum": ["SALE_GOODS", "PURCHASE_GOODS", "SERVICE_PROVIDED", "SERVICE_TAKEN", "TRANSFER", "IMPORT", "EXPORT"] },
    "date": { "$ref": "common.schema.json#/$defs/date" },
    "counterparty": { "$ref": "common.schema.json#/$defs/entity_id" },
    "counterparty_kind": { "type": "string", "enum": ["B2B", "B2C", "GOVERNMENT", "RELATED_PARTY"] },
    "origin": { "$ref": "common.schema.json#/$defs/jurisdiction" },
    "destination": { "$ref": "common.schema.json#/$defs/jurisdiction" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["NFE", "NFCE", "NFSE", "CTE", "OTHER"] },
        "key": { "type": "string", "pattern": "^\\d{44}$" },
        "number": { "type": "string" }
      },
      "required": ["type"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "ncm": { "$ref": "common.schema.json#/$defs/ncm" },
          "nbs": { "$ref": "common.schema.json#/$defs/nbs" },
          "cfop": { "type": "string", "pattern": "^\\d{4}$" },
          "quantity": { "type": "number", "minimum": 0 },
          "amount": { "$ref": "common.schema.json#/$defs/money" }
        },
        "required": ["description", "amount"]
      }
    },
    "total": { "$ref": "common.schema.json#/$defs/money" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/evidence_id" }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "required": ["transaction_id", "taxpayer", "kind", "date", "counterparty_kind", "items", "total", "evidence", "provenance"]
}
