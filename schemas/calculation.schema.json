{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ponte-projetos.dev/schemas/calculation.schema.json",
  "title": "Calculation (L4)",
  "description": "Execução reproduzível de um motor de cálculo. Rule GOVERNS Calculation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "calculation_id": { "$ref": "common.schema.json#/$defs/calculation_id" },
    "purpose": { "type": "string", "minLength": 1 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "common.schema.json#/$defs/git_commit" },
        "source": { "$ref": "common.schema.json#/$defs/source_id" },
        "role": { "type": "string", "enum": ["CANONICAL", "CANDIDATE", "PRELIMINARY_SIMULATOR"] }
      },
      "required": ["name", "version", "role"]
    },
    "taxpayer": { "$ref": "common.schema.json#/$defs/taxpayer_id" },
    "period": { "$ref": "common.schema.json#/$defs/period" },
    "normative_snapshot": { "$ref": "common.schema.json#/$defs/normative_snapshot" },
    "governed_by": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/rule_id" }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(EV|OBS|TX|TP)-[A-Z0-9-]+$" },
      "description": "Evidências, observações, transações ou perfil usados como entrada"
    },
    "parameters": {
      "type": "object",
      "description": "Parâmetros efetivamente passados ao motor (devem derivar de governed_by)",
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "$ref": "common.schema.json#/$defs/money" },
          { "$ref": "common.schema.json#/$defs/percent" },
          { "type": "number" },
          { "type": "string" }
        ]
      }
    },
    "reproducible": { "type": "boolean" },
    "reference_result": {
      "type": "object",
      "description": "Resultado de referência produzido pelo modelo canônico para comparação",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "common.schema.json#/$defs/money" },
          { "$ref": "common.schema.json#/$defs/percent" },
          { "type": "number" },
          { "type": "string" }
        ]
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["MATCH", "MISMATCH", "NOT_COMPARED"] },
        "tolerance": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "required": ["status"]
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "required": ["calculation_id", "purpose", "engine", "period", "normative_snapshot", "governed_by", "inputs", "outputs", "reproducible", "provenance"],
  "allOf": [
    {
      "if": { "properties": { "engine": { "properties": { "role": { "const": "CANDIDATE" } }, "required": ["role"] } } },
      "then": { "required": ["reference_result", "comparison"] }
    }
  ]
}
