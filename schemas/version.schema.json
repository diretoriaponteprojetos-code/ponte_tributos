{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ponte-projetos.dev/schemas/version.schema.json",
  "title": "Version (governança)",
  "description": "Versionamento de qualquer objeto canônico. Correção nunca sobrescreve.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version_id": { "$ref": "common.schema.json#/$defs/version_id" },
    "object_id": { "type": "string", "pattern": "^[A-Z]+-[A-Z0-9-]+$" },
    "object_type": {
      "type": "string",
      "enum": [
        "Source", "Evidence", "Authority", "Rule", "Entity", "Taxpayer", "Transaction",
        "TaxTreatment", "Calculation", "Observation", "Claim", "Decision",
        "ResearchFinding", "CandidateUpdate"
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "common.schema.json#/$defs/datetime" },
    "supersedes": { "$ref": "common.schema.json#/$defs/version_id" },
    "reason": { "type": "string", "minLength": 1 },
    "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "required": ["version_id", "object_id", "object_type", "version", "created_at", "reason", "content_sha256", "provenance"],
  "allOf": [
    {
      "if": { "properties": { "version": { "minimum": 2 } } },
      "then": { "required": ["supersedes"] }
    }
  ]
}
