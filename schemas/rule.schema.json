{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ponte-projetos.dev/schemas/rule.schema.json",
  "title": "Rule (L2)",
  "description": "Texto jurídico transformado em regra computável, com vigência. Ver docs/arquitetura/04-temporalidade.md",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rule_id": { "$ref": "common.schema.json#/$defs/rule_id" },
    "title": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tax": { "$ref": "common.schema.json#/$defs/tax" },
        "incidence_hypothesis": {
          "type": "string",
          "minLength": 1,
          "description": "Hipótese de incidência (fato gerador) em linguagem controlada"
        }
      },
      "required": ["tax", "incidence_hypothesis"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jurisdiction": { "$ref": "common.schema.json#/$defs/jurisdiction" },
        "regimes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/regime" },
          "description": "Vazio ou ausente = todos os regimes"
        },
        "cnae": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/cnae" } },
        "ncm": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ncm" } },
        "nbs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nbs" } },
        "taxpayer_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Condições sobre a situação da empresa, em linguagem controlada"
        }
      },
      "required": ["jurisdiction"]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_date": { "$ref": "common.schema.json#/$defs/period" },
        "predicates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["event_date"]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["RATE", "EXEMPTION", "CREDIT", "REDUCTION", "OBLIGATION", "DEADLINE", "BASE_DEFINITION"]
        },
        "rate": { "$ref": "common.schema.json#/$defs/percent" },
        "reduction": { "$ref": "common.schema.json#/$defs/percent" },
        "description": { "type": "string" }
      },
      "required": ["kind"],
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "RATE" } } },
          "then": { "required": ["rate"] }
        },
        {
          "if": { "properties": { "kind": { "const": "REDUCTION" } } },
          "then": { "required": ["reduction"] }
        }
      ]
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "rule": { "$ref": "common.schema.json#/$defs/rule_id" }
        },
        "required": ["description"]
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "common.schema.json#/$defs/source_id" },
        "article": { "type": "string" },
        "paragraph": { "type": "string" },
        "item": { "type": "string" }
      },
      "required": ["source"]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publication_date": { "$ref": "common.schema.json#/$defs/date" },
        "valid_from": { "$ref": "common.schema.json#/$defs/date" },
        "valid_until": { "$ref": "common.schema.json#/$defs/nullable_date" },
        "retrieved_at": { "$ref": "common.schema.json#/$defs/date" }
      },
      "required": ["valid_from", "valid_until"]
    },
    "supersedes": { "$ref": "common.schema.json#/$defs/rule_id" },
    "superseded_by": { "$ref": "common.schema.json#/$defs/rule_id" },
    "status": {
      "type": "string",
      "enum": ["CANDIDATE", "DRAFT", "ACTIVE", "SUPERSEDED", "REVOKED"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/evidence_id" }
    },
    "review": { "$ref": "common.schema.json#/$defs/review_id" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "required": [
    "rule_id", "title", "subject", "scope", "condition", "effect",
    "authority", "validity", "status", "evidence", "provenance"
  ],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ACTIVE" } } },
      "then": { "required": ["review"] }
    },
    {
      "if": { "properties": { "status": { "const": "SUPERSEDED" } } },
      "then": { "required": ["superseded_by"] }
    }
  ]
}
